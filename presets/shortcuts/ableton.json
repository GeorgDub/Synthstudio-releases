{
  "version": "1.0",
  "profile": "Ableton Live",
  "description": "Ableton Live-kompatible Tastaturkürzel für Benutzer, die von Ableton zu Synthstudio wechseln.",
  "shortcuts": {
    "transport.play":              "Space",
    "transport.stop":              "0",
    "transport.record":            "Shift+Space",
    "transport.loop":              "Ctrl+Shift+L",
    "transport.tapTempo":          "Ctrl+Shift+T",
    "transport.metronome":         "Ctrl+Shift+M",
    "transport.bpmUp":             "Ctrl+ArrowUp",
    "transport.bpmDown":           "Ctrl+ArrowDown",
    "transport.bpmUpLarge":        "Ctrl+Shift+ArrowUp",
    "transport.bpmDownLarge":      "Ctrl+Shift+ArrowDown",
    "transport.toStart":           "Home",
    "transport.toEnd":             "End",

    "pattern.new":                 "Ctrl+Shift+N",
    "pattern.duplicate":           "Ctrl+D",
    "pattern.delete":              "Delete",
    "pattern.rename":              "Ctrl+R",
    "pattern.next":                "Ctrl+ArrowRight",
    "pattern.prev":                "Ctrl+ArrowLeft",

    "pianoroll.open":              "Ctrl+Shift+N",
    "pianoroll.close":             "Escape",
    "pianoroll.zoomIn":            "Plus",
    "pianoroll.zoomOut":           "Minus",
    "pianoroll.zoomReset":         "Ctrl+0",
    "pianoroll.selectAll":         "Ctrl+A",
    "pianoroll.deleteNotes":       "Delete",
    "pianoroll.copy":              "Ctrl+C",
    "pianoroll.cut":               "Ctrl+X",
    "pianoroll.paste":             "Ctrl+V",
    "pianoroll.transpose.up":      "Shift+ArrowUp",
    "pianoroll.transpose.down":    "Shift+ArrowDown",
    "pianoroll.transpose.octaveUp":"Shift+Ctrl+ArrowUp",
    "pianoroll.transpose.octaveDown":"Shift+Ctrl+ArrowDown",
    "pianoroll.quantize":          "Ctrl+U",
    "pianoroll.quantize.q4":       "Q+4",
    "pianoroll.quantize.q8":       "Q+8",
    "pianoroll.quantize.q16":      "Q+6",
    "pianoroll.quantize.q32":      "Q+3",
    "pianoroll.tool.pencil":       "B",
    "pianoroll.tool.select":       "Escape",
    "pianoroll.tool.eraser":       "E",
    "pianoroll.move.forward":      "ArrowRight",
    "pianoroll.move.backward":     "ArrowLeft",

    "mixer.open":                  "F9",
    "mixer.allMutesOff":           "Alt+M",
    "mixer.allSolosOff":           "Alt+S",
    "mixer.nextChannel":           "Tab",
    "mixer.prevChannel":           "Shift+Tab",

    "synth.open":                  "Ctrl+Alt+P",
    "synth.presetLoad":            "Ctrl+L",
    "synth.presetSave":            "Ctrl+S",
    "synth.presetNext":            "ArrowRight",
    "synth.presetPrev":            "ArrowLeft",
    "synth.presetRandom":          "Ctrl+R",
    "synth.resetAll":              "Ctrl+Shift+R",

    "view.synth":                  "F1",
    "view.sequencer":              "F2",
    "view.pianoroll":              "F3",
    "view.mixer":                  "Ctrl+Alt+M",
    "view.arrangement":            "Ctrl+Shift+A",
    "view.browser":                "Ctrl+Alt+B",
    "view.settings":               "Ctrl+,",
    "view.fullscreen":             "F11",

    "project.new":                 "Ctrl+N",
    "project.open":                "Ctrl+O",
    "project.save":                "Ctrl+S",
    "project.saveAs":              "Ctrl+Shift+S",
    "project.exportWav":           "Ctrl+Shift+W",
    "project.exportMidi":          "Ctrl+Shift+E",
    "project.openLast":            "Ctrl+Shift+O",

    "edit.undo":                   "Ctrl+Z",
    "edit.redo":                   "Ctrl+Y",
    "edit.cut":                    "Ctrl+X",
    "edit.copy":                   "Ctrl+C",
    "edit.paste":                  "Ctrl+V",
    "edit.selectAll":              "Ctrl+A",
    "edit.deselect":               "Escape",
    "edit.delete":                 "Delete",
    "edit.find":                   "Ctrl+F"
  }
}
